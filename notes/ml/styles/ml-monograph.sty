\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/ml-monograph}[2026/11/20 Academic monograph layout]

% A presentation layer only. The document body and all counters are unchanged.
\RequirePackage[sc]{mathpazo}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[subfigure]{tocloft}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\RequirePackage{caption}

\definecolor{MLink}{HTML}{24282C}
\definecolor{MLaccent}{HTML}{3E5260}
\definecolor{MLrule}{HTML}{BCC2C7}
\definecolor{MLmuted}{HTML}{626A70}
\definecolor{MLwash}{HTML}{F6F7F8}

\setstretch{1.055}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{3pt plus 1pt minus .5pt}
\setlength{\emergencystretch}{1.5em}
\frenchspacing
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\setlength{\abovedisplayskip}{9pt plus 2pt minus 3pt}
\setlength{\belowdisplayskip}{9pt plus 2pt minus 3pt}
\setlist{itemsep=2pt plus .5pt,parsep=1pt,topsep=5pt,partopsep=0pt,leftmargin=1.8em}
\setlist[itemize]{before=\raggedright}
\setlist[enumerate,2]{label=\alph*.,leftmargin=1.7em}

% A muted rule and a small label replace the saturated lecture-note boxes.
\tcbset{MLscholarlybox/.style={
 enhanced,breakable,sharp corners,colback=white,colframe=MLrule,
 colbacktitle=white,coltitle=MLaccent,colupper=MLink,
 boxrule=0pt,leftrule=.65pt,titlerule=0pt,
 boxsep=0pt,left=10pt,right=3pt,top=5pt,bottom=5pt,
 lefttitle=10pt,righttitle=3pt,toptitle=4pt,bottomtitle=4pt,
 fonttitle=\normalfont\small\scshape,
 before skip=11pt plus 2pt,after skip=11pt plus 2pt,
 pad at break*=0pt,compress page=none}}
\let\MLoriginaltcolorbox\tcolorbox
\RenewDocumentCommand\tcolorbox{O{}}{\MLoriginaltcolorbox[#1,MLscholarlybox]}

% Code remains copyable; subdued syntax and a single rule aid print reading.
\lstset{
 basicstyle=\ttfamily\fontsize{8.5}{11}\selectfont,
 columns=fullflexible,keepspaces=true,showstringspaces=false,
 breaklines=true,breakatwhitespace=false,breakindent=1.4em,
 frame=leftline,framerule=.35pt,rulecolor=\color{MLrule},
 backgroundcolor=\color{MLwash},
 numbers=left,numberstyle=\ttfamily\fontsize{6.5}{8}\selectfont\color{MLmuted},
 numbersep=7pt,xleftmargin=14pt,framexleftmargin=4pt,
 aboveskip=8pt,belowskip=8pt,
 keywordstyle=\bfseries\color{MLaccent},
 commentstyle=\itshape\color{MLmuted},
 stringstyle=\color{MLink}}

\captionsetup{font=small,labelfont=bf,labelsep=period,
 justification=justified,singlelinecheck=true,skip=8pt}
\setlength{\intextsep}{13pt plus 3pt minus 3pt}
\setlength{\textfloatsep}{16pt plus 3pt minus 3pt}
\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\renewcommand{\arraystretch}{1.12}
\hypersetup{linkcolor=MLaccent,citecolor=MLaccent,urlcolor=MLaccent,
 bookmarksnumbered=true,bookmarksopen=false,pdfpagelayout=TwoPageRight}

% Preserve the existing section-based chapter, theorem and equation numbers.
\titleformat{\section}[display]
 {\normalfont\LARGE\bfseries\raggedright}
 {\color{MLaccent}\fontsize{34}{36}\selectfont\thesection}
 {12pt}{}[{\vspace{8pt}\color{MLrule}\titlerule[.45pt]}]
\titlespacing*{\section}{0pt}{8pt}{22pt}
\titleformat{\subsection}
 {\normalfont\large\bfseries\raggedright}{\thesubsection}{.7em}{}
\titlespacing*{\subsection}{0pt}{16pt plus 3pt minus 2pt}{7pt}
\titleformat{\subsubsection}
 {\normalfont\normalsize\bfseries\raggedright}{\thesubsubsection}{.7em}{}
\titlespacing*{\subsubsection}{0pt}{12pt plus 2pt minus 2pt}{5pt}
\setcounter{tocdepth}{2}
\renewcommand{\cfttoctitlefont}{\normalfont\Huge\bfseries}
\renewcommand{\cftaftertoctitle}{\par\vspace{10pt}\color{MLrule}\hrule}
\setlength{\cftbeforetoctitleskip}{20pt}
\setlength{\cftaftertoctitleskip}{25pt}
\setlength{\cftbeforepartskip}{12pt}
\renewcommand{\cftpartfont}{\normalfont\small\bfseries}
\renewcommand{\cftpartpagefont}{\normalfont\small}
\renewcommand{\cftsecfont}{\normalfont\small}
\renewcommand{\cftsecpagefont}{\normalfont\small}
\setlength{\cftbeforesecskip}{3pt}
\renewcommand{\cftsubsecfont}{\normalfont\footnotesize\color{MLmuted}}
\renewcommand{\cftsubsecpagefont}{\normalfont\footnotesize}
\setlength{\cftbeforesubsecskip}{0pt}
\cftsetindents{section}{0pt}{2.1em}
\cftsetindents{subsection}{2.1em}{3.2em}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\footnotesize\color{MLmuted}\nouppercase{\leftmark}}
\fancyhead[RO]{\footnotesize\scshape\color{MLmuted}Notes on Machine Learning}
\fancyfoot[LE,RO]{\small\thepage}
\renewcommand{\headrulewidth}{.3pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[LE,RO]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\sectionmark}[1]{\markboth{\thesection\quad #1}{}}

% Move only the Part TOC writes: the original writes precede their page breaks.
\ExplSyntaxOn
\NewDocumentCommand\MLIfPartTitleTF{mmm}
 {\str_if_eq:eeTF{\str_range:nnn{#1}{1}{5}}{Part~}{#2}{#3}}
\ExplSyntaxOff
\newif\ifMLmainmatter
\newcommand\MLpendingparttoc{}
\let\MLoriginaladdcontentsline\addcontentsline
\RenewDocumentCommand\addcontentsline{mmm}{%
 \MLIfPartTitleTF{#3}
  {\gdef\MLpendingparttoc{\MLoriginaladdcontentsline{#1}{part}{#3}}}
  {\MLoriginaladdcontentsline{#1}{#2}{#3}}}
\makeatletter
\def\toclevel@part{0}
\def\MLparttypeset#1: #2\MLstop{%
 {\large\scshape\color{MLaccent}#1\par}
 \vspace{16pt}{\fontsize{29}{35}\selectfont\bfseries\raggedright #2\par}
 \vspace{22pt}{\color{MLrule}\hrule height .5pt}}
\newcommand\MLpartpage[1]{%
 \clearpage
 \ifMLmainmatter\else\cleardoublepage\pagenumbering{arabic}\global\MLmainmattertrue\fi
 \thispagestyle{empty}\markboth{}{}\phantomsection
 \MLpendingparttoc\global\let\MLpendingparttoc\@empty
 {\setlength{\parindent}{0pt}\vspace*{.23\textheight}\MLparttypeset#1\MLstop\vfill}\clearpage}
\let\MLoriginalsection\section
\RenewDocumentCommand\section{s o m}{%
 \IfBooleanTF{#1}
  {\MLIfPartTitleTF{#3}{\MLpartpage{#3}}{\MLoriginalsection*{#3}}}
  {\clearpage\IfNoValueTF{#2}{\MLoriginalsection{#3}}{\MLoriginalsection[#2]{#3}}\thispagestyle{plain}}}
\AddToHook{begindocument/end}{%
 \let\MLoriginaltableofcontents\tableofcontents
 \renewcommand\tableofcontents{\pagenumbering{roman}\markboth{Contents}{Contents}\MLoriginaltableofcontents}}
\renewcommand\maketitle{%
 \hypersetup{pageanchor=false}\begin{titlepage}\thispagestyle{empty}\setlength{\parindent}{0pt}
 \vspace*{.16\textheight}
 {\color{MLaccent}\rule{.18\textwidth}{.8pt}\par}\vspace{25pt}
 {\fontsize{32}{39}\selectfont\bfseries\raggedright\@title\par}
 \vspace{32pt}{\Large\@author\par}
 \vfill{\large\@date\par}\vspace*{15pt}
 \end{titlepage}\null\thispagestyle{empty}\newpage\hypersetup{pageanchor=true}}

% Examples and exercises begin below their heading, including a leading list.
\newtheoremstyle{MLexample}{9pt plus 2pt}{9pt plus 2pt}
 {\normalfont}{}{\bfseries\color{MLaccent}}{.}{\newline}{}
\patchcmd{\example}{\th@definition}{\th@MLexample}{}{}
\patchcmd{\exercise}{\th@definition}{\th@MLexample}{}{}
\patchcmd{\problem}{\th@definition}{\th@MLexample}{}{}
% Materialize a pending theorem heading before a leading list begins.
\BeforeBeginEnvironment{itemize}{\if@inlabel\leavevmode\par\nobreak\ifx\thmheadnl\relax\else\vspace{-\baselineskip}\fi\fi}
\BeforeBeginEnvironment{enumerate}{\if@inlabel\leavevmode\par\nobreak\ifx\thmheadnl\relax\else\vspace{-\baselineskip}\fi\fi}
% Paragraph columns should not stretch short labels into widely spaced words.
\AtBeginEnvironment{tabular}{\appto\@arrayparboxrestore{\raggedright\arraybackslash}}

\makeatother
% Reserve room for a heading and the opening lines of its following block.
\pretocmd{\subsection}{\Needspace{6\baselineskip}}{}{}
\pretocmd{\subsubsection}{\Needspace{5\baselineskip}}{}{}
\AtBeginDocument{\color{MLink}}
\endinput
